{
  "$schema": "https://opencode.ai/config.json",

  "model": "github-copilot/claude-sonnet-5",

  "skills": {
    "paths": [".agents/skills"]
  },

  "mcp": {
    "jira-ccp": {
      "type": "remote",
      "url": "https://flow.api.de.comcast.com/orgs/ide-common/pools/jira-ccp/mcp",
      "enabled": false,
      "oauth": {}
    }
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "sudo *": "deny"
    }
  }
}
